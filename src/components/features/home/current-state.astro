---
import Section from "@/components/ui/section.astro";
import SectionDescription from "@/components/ui/section-description.astro";
import SectionTitle from "@/components/ui/section-title.astro";
import { FadeContent } from "@/components/ui/fade-content";
import { Card } from "@/components/ui/card";

const painPoints = [
  "Les réservations se prennent au téléphone, en plein service",
  "Le menu QR existe, mais vos clients ne commandent pas avec",
  "Une tâche répétitive vous prend des heures chaque semaine",
];
---

<Section id="problematiques" innerClass="lg:py-24">
  <div class="contents" slot="intro">
    <FadeContent client:visible>
      <SectionTitle eyebrow="Au quotidien">
        Votre salle tourne. Vos outils, pas toujours.
      </SectionTitle>
      <SectionDescription>
        Le numérique devrait vous faire gagner du temps, pas vous en prendre.
      </SectionDescription>
    </FadeContent>
  </div>

  <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-5 lg:gap-16 items-center">
    <div class="lg:col-span-2 text-center lg:text-left">
      <FadeContent client:visible delay={100}>
        <p class="text-foreground text-2xl font-semibold leading-tight tracking-tight sm:text-3xl mb-3">
          Ça vous parle ?
        </p>
      </FadeContent>
      <FadeContent client:visible delay={200}>
        <p class="text-muted-foreground text-base leading-relaxed">
          Ce sont des situations que j'ai rencontrées dans des restaurants et des
          bars de Cayenne. Chacune peut se régler avec un outil simple, pensé pour
          votre façon de travailler.
        </p>
      </FadeContent>
    </div>

    <div class="lg:col-span-3">
      <FadeContent client:visible delay={300}>
        <div class="grid gap-4 sm:gap-5" style="grid-auto-rows: 1fr;">
          {painPoints.map((point, idx) => (
            <Card
              key={idx}
              className="flex-row items-center gap-4 border-foreground/10 bg-card/30 px-5 py-4 sm:px-6 sm:py-5 shadow-none transition-all duration-300 hover:border-foreground/20"
            >
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-foreground/5 text-sm font-medium text-foreground/40">
                {idx + 1}
              </span>
              <p class="text-foreground text-base font-medium leading-snug">
                {point}
              </p>
            </Card>
          ))}
        </div>
      </FadeContent>
    </div>
  </div>
</Section>
