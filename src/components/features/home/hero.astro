---
import { FadeContent } from "@/components/ui/fade-content";
import { AnimatedShinyText } from "@/components/ui/animated-shiny-text";
import WhatsappButton from "@/components/ui/whatsapp-button.astro";
---

<section class="relative min-h-[85vh] sm:min-h-screen flex items-center justify-center overflow-hidden">
  <div class="absolute inset-0 bg-background" />
  <div
    class="absolute inset-0 opacity-[0.04]"
    style="background-image:
      linear-gradient(rgba(255,255,255,0.3) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.3) 1px, transparent 1px);
      background-size: 64px 64px;"
  />
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,var(--color-primary)_0%,transparent_70%)] opacity-[0.06]" />

  <div class="relative max-w-5xl mx-auto px-5 sm:px-6 lg:px-8 py-16 lg:py-32 text-center">
    <FadeContent client:visible>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-foreground/30 mb-6 sm:mb-8">
        Portalstudio · Cayenne
      </p>
    </FadeContent>

    <FadeContent client:visible delay={150}>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl text-foreground max-w-4xl mx-auto leading-[1.08] tracking-[-0.03em] font-semibold text-balance">
        Des outils numériques faits pour votre établissement,
        <AnimatedShinyText>à votre nom</AnimatedShinyText>.
      </h1>
    </FadeContent>

    <FadeContent client:visible delay={300}>
      <p class="text-base sm:text-lg text-foreground/50 max-w-xl mx-auto mt-6 sm:mt-8 leading-relaxed text-pretty">
        Je viens sur place, je regarde comment vous tournez, et je vous propose
        l'outil qui vous fait gagner du temps ou des clients.
      </p>
    </FadeContent>

    <FadeContent client:visible delay={450}>
      <div class="mt-8 sm:mt-10 flex items-center justify-center">
        <WhatsappButton size="hero" />
      </div>
    </FadeContent>
  </div>
</section>
