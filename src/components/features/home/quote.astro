---
import { FadeContent } from "@/components/ui/fade-content";
import SectionTitle from "@/components/ui/section-title.astro";
import SectionDescription from "@/components/ui/section-description.astro";
import WhatsappButton from "@/components/ui/whatsapp-button.astro";
import { Phone, Mail } from "lucide-react";
import { PHONE_DISPLAY, PHONE_TEL, EMAIL } from "@/lib/contact";
---

<section id="contact" class="relative scroll-mt-20 overflow-hidden border-t border-border/60 py-16 sm:py-20 lg:py-28">
  <div
    class="absolute inset-0 opacity-[0.03]"
    style="background-image:
      linear-gradient(rgba(255,255,255,0.3) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.3) 1px, transparent 1px);
      background-size: 48px 48px;"
  />

  <div class="relative mx-auto max-w-2xl px-5 text-center sm:px-6 lg:px-8">
    <FadeContent client:visible>
      <SectionTitle eyebrow="Contact">
        On en parle chez vous ?
      </SectionTitle>
      <SectionDescription>
        Écrivez-moi sur WhatsApp : on fixe un moment pour que je passe voir votre établissement. Sans engagement.
      </SectionDescription>
    </FadeContent>

    <FadeContent client:visible delay={150}>
      <div class="mt-8 flex flex-col items-center gap-6">
        <WhatsappButton size="hero" />
        <div class="flex flex-col items-center gap-3 text-sm text-muted-foreground sm:flex-row sm:gap-6">
          <a href={PHONE_TEL} class="inline-flex items-center gap-2 transition-colors hover:text-foreground">
            <Phone size={15} aria-hidden="true" />
            {PHONE_DISPLAY}
          </a>
          <a href={`mailto:${EMAIL}`} class="inline-flex items-center gap-2 transition-colors hover:text-foreground">
            <Mail size={15} aria-hidden="true" />
            {EMAIL}
          </a>
        </div>
      </div>
    </FadeContent>
  </div>
</section>
