---
import Logo from "@/components/ui/logo";
import WhatsappButton from "@/components/ui/whatsapp-button.astro";
---

<header
  class="fixed top-0 right-0 left-0 z-50 h-16 flex w-full items-center justify-between gap-3 bg-transparent px-4 sm:px-8 backdrop-blur-2xl"
>
  <a href="/" class="flex shrink-0 gap-2 sm:gap-3 justify-center items-center">
    <Logo className="w-10 sm:w-12" />
    <span class="hidden min-[400px]:inline">Portalstudio</span>
  </a>
  <!--
    Bouton caché tant qu'un bouton « passage sur place » de la page est visible
    (en-tête ou bloc contact) : il « monte » dans la barre quand on scrolle.
  -->
  <div
    id="nav-cta"
    data-visible="false"
    class="transition-all duration-300 ease-out data-[visible=false]:pointer-events-none data-[visible=false]:translate-y-3 data-[visible=false]:opacity-0 motion-reduce:transition-none"
  >
    <WhatsappButton size="nav" />
  </div>
</header>

<script>
  const nav = document.getElementById("nav-cta");
  const targets = [...document.querySelectorAll("[data-page-cta]")];

  if (nav) {
    if (targets.length === 0 || !("IntersectionObserver" in window)) {
      // Pages sans bouton dans le contenu (mentions légales…) : toujours visible.
      nav.dataset.visible = "true";
    } else {
      const onScreen = new Set();
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) onScreen.add(entry.target);
            else onScreen.delete(entry.target);
          }
          nav.dataset.visible = String(onScreen.size === 0);
        },
        // La barre fait 64 px : un bouton caché dessous compte comme sorti.
        { rootMargin: "-64px 0px 0px 0px" },
      );
      targets.forEach((t) => observer.observe(t));
    }
  }
</script>
